# -----------------------------------------------------------------------------
# SafeSchool root environment example
# -----------------------------------------------------------------------------
# This file documents environment variables used across backend, frontend,
# mobile, Docker, and future integrations.
#
# Do not put real production secrets here.
# Copy service-specific values into backend/.env, frontend/.env, or mobile env
# files when those apps need them.
# -----------------------------------------------------------------------------

# Application
APP_NAME=SafeSchool
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Backend / Laravel
BACKEND_URL=http://localhost:8000
API_URL=http://localhost:8000/api

# Frontend / Vite
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
VITE_CLERK_PUBLISHABLE_KEY=

# Mobile / Expo
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Database / MySQL Docker
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=safeschool
DB_USERNAME=safeschool
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Mailpit / Local Email
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@safeschool.local
MAIL_FROM_NAME="${APP_NAME}"

# Clerk Auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=
CLERK_JWT_KEY=
CLERK_JWT_AUTHORIZED_PARTIES=http://localhost:5173

# Maps
MAPBOX_TOKEN=
GOOGLE_MAPS_KEY=

# Broadcasting / Realtime
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
SOKETI_HOST=
SOKETI_PORT=6001

# Queue / Cache
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# Observability
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
SENTRY_DSN_MOBILE=

# Security reminders:
# - Never commit real .env files.
# - Rotate secrets if they are exposed.
# - Use hosting/provider secret managers in production.
